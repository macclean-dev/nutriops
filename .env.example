# NutriOPS — environment variables
# Copie esse arquivo pra .env.local e preencha. .env.local nunca vai pro git.
# Em produção, configure essas mesmas variáveis em Vercel → Project → Settings → Environment Variables.

# Senha do painel admin (https://nutriops.uniwares.net/admin)
# Sem isso, o fallback hardcoded é usado e um aviso aparece no console.
VITE_ADMIN_PASSWORD=troque-essa-senha-forte

# Supabase compartilhado por todos os tenants seed (Swiss, Bäckerei, DBK).
# Quando preenchidas, qualquer device que abrir o app já entra com sync
# automático — não precisa configurar device por device.
# Pega em: Supabase Dashboard → Settings → API
VITE_SB_URL=https://SEU_PROJETO.supabase.co
VITE_SB_ANON_KEY=eyJhbGc...

# Extração de planilha por foto/PDF via IA (api/extract-template.js).
# SEM prefixo VITE_ de propósito — só a função serverless lê isso
# (process.env), nunca o bundle do client. Se vier com VITE_, a chave
# vaza no JS público e qualquer um pode gastar sua cota da Anthropic.
# Pega em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
